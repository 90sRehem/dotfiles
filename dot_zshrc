# ============================================================================
# BASIC ZSH CONFIGURATION
# ============================================================================

# History Configuration
# Store command history in ~/.histfile with 10k entries
HISTFILE=~/.histfile
HISTSIZE=10000           # Number of commands to remember in current session
SAVEHIST=10000          # Number of commands to save to history file

# ZSH Options
setopt autocd           # Automatically cd into directories by typing their name
setopt beep            # Enable beep on errors
setopt notify          # Report status of background jobs immediately

# Key bindings (emacs-style)
bindkey -e

# ============================================================================
# COMPLETION SYSTEM
# ============================================================================

# Configure completion system
zstyle :compinstall filename '/home/rehem/.zshrc'

# Load and initialize completion system
autoload -Uz compinit
compinit

# ============================================================================
# PLUGIN MANAGER - ZINIT
# ============================================================================

# Zinit Installation and Setup
# Zinit is a flexible and fast ZSH plugin manager
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

# Source Zinit
source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# Load Zinit Annexes
# These provide additional functionality for Zinit
zinit light-mode for \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/zinit-annex-patch-dl \
    zdharma-continuum/zinit-annex-rust

# ============================================================================
# ZSH PLUGINS
# ============================================================================

# Essential ZSH Plugins
zinit light zsh-users/zsh-autosuggestions      # Fish-like autosuggestions
zinit light zsh-users/zsh-syntax-highlighting  # Syntax highlighting for commands
zinit light zsh-users/zsh-completions         # Additional completion definitions
zinit light Aloxaf/fzf-tab                    # Replace default completion with fzf
zinit light MichaelAquilina/zsh-you-should-use # Reminds you to use aliases
zinit light djui/alias-tips                   # Shows alias suggestions
zinit light hlissner/zsh-autopair             # Auto-close brackets and quotes
zinit light zsh-users/zsh-history-substring-search # History search with arrows

# Reload completions after loading plugins
autoload -U compinit && compinit

# ============================================================================
# FZF-TAB CONFIGURATION
# ============================================================================

# Configure fzf-tab for better completion experience
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza -1 --color=always $realpath'

# ============================================================================
# PATH CONFIGURATION
# ============================================================================

# Add custom paths to PATH environment variable
export PATH=/home/rehem/.opencode/bin:$PATH                    # OpenCode CLI
export PATH=$PATH:/home/rehem/.local/bin                       # Local binaries
export PATH=$PATH:/home/rehem/.local/share/nvim/mason/bin      # Neovim Mason tools

# ============================================================================
# PROMPT AND THEME
# ============================================================================

# Initialize Oh My Posh with Catppuccin theme
# Oh My Posh provides a customizable and fast prompt
eval "$(oh-my-posh init zsh --config ~/.config/omp/themes/catppuccin.omp.json)"

# ============================================================================
# DEVELOPMENT TOOLS INITIALIZATION
# ============================================================================

# Mise (Runtime Version Manager)
# Manages multiple versions of programming languages
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# Zoxide (Smart Directory Navigation)
# A smarter cd command that learns your habits
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# FZF (Fuzzy Finder)
# Command-line fuzzy finder for files, history, processes, etc.
if command -v fzf &> /dev/null; then
  if [[ -f /usr/share/zsh/site-functions/_fzf ]]; then
    source /usr/share/zsh/site-functions/_fzf
  fi
  if [[ -f /usr/share/fzf/key-bindings.zsh ]]; then
    source /usr/share/fzf/key-bindings.zsh
  fi
fi

# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================

# Default Editors
export EDITOR="nvim"        # Primary editor
export SUDO_EDITOR="$EDITOR" # Editor for sudo operations

# ============================================================================
# FILE SYSTEM ALIASES
# ============================================================================

# Enhanced ls commands using eza
alias ls='eza -lh --group-directories-first --icons=auto'  # List with details and icons
alias lsa='ls -a'                                          # List all files including hidden
alias lt='eza --tree --level=2 --long --icons --git'       # Tree view with git status
alias lta='lt -a'                                          # Tree view with hidden files

# File operations
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"  # Fuzzy find files with preview

# Directory navigation
alias ..='cd ..'        # Go up one directory
alias ...='cd ../..'    # Go up two directories
alias ....='cd ../../..' # Go up three directories

# Custom cd function with zoxide integration
alias cd="zd"
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf " \U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}

# Open files with default application
open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

# ============================================================================
# TMUX & TMUXIFIER ALIASES
# ============================================================================

# Basic Tmux Operations
alias t='tmux'                    # Start tmux
alias ta='tmux attach'            # Attach to existing session
alias tad='tmux attach -d'        # Attach and detach others
alias ts='tmux new-session'       # Create new session
alias tl='tmux list-sessions'     # List all sessions
alias tksv='tmux kill-server'     # Kill tmux server
alias tkss='tmux kill-session'    # Kill current session
alias tmuxconf='nvim ~/.tmux.conf' # Edit tmux configuration

# Tmuxifier Project Management
alias tx='tmuxifier'              # Tmuxifier command
alias txs='tmuxifier start'       # Start project session
alias txn='tmuxifier new'         # Create new project template
alias txl='tmuxifier list'        # List available projects
alias txe='tmuxifier edit'        # Edit project template
alias txd='tmuxifier delete'      # Delete project template
alias txc='tmuxifier copy'        # Copy project template
alias txw='tmuxifier load-window' # Load window layout

# Tmux Helper Functions
# Create new tmux session with optional name
tn() {
  if [ $# -eq 0 ]; then
    tmux new-session
  else
    tmux new-session -s "$1"
  fi
}

# Kill tmux session with optional name
tk() {
  if [ $# -eq 0 ]; then
    tmux kill-session
  else
    tmux kill-session -t "$1"
  fi
}

# Create tmux session named after current directory
tcd() {
  local session_name=$(basename "$PWD")
  tmux new-session -d -s "$session_name" -c "$PWD"
  tmux attach-session -t "$session_name"
}

