# CHEZMOI DOTFILES MANAGEMENT
# ============================================================================

# Chezmoi aliases for dotfiles management
alias ca="chezmoi add"          # Add file to chezmoi
alias ce="chezmoi edit"         # Edit file with chezmoi
alias cu="chezmoi update"       # Update chezmoi
alias capply="chezmoi apply"    # Apply chezmoi changes
alias cdiff="chezmoi diff"      # Show chezmoi differences

# Edit and apply in one command
cea() {
    chezmoi edit --apply "$1"
}

# Edit with watch mode (auto-apply on save)
cew() {
    chezmoi edit --watch "$1"
}

# Edit source file directly and apply
ces() {
    local file="$1"
    local source_file=$(chezmoi source-path "$file")
    if [[ -n "$source_file" ]]; then
        nvim "$source_file" && chezmoi apply "$file"
    else
        echo "File not managed by chezmoi: $file"
    fi
}

# Auto-sync edited files to chezmoi
csync() {
    local file="$1"
    if [[ -z "$file" ]]; then
        echo "Usage: csync <file>"
        return 1
    fi
    
    # Add file to chezmoi if not already managed
    if ! chezmoi managed "$file" &>/dev/null; then
        chezmoi add "$file"
        echo "Added $file to chezmoi"
    else
        # Re-add to sync changes
        chezmoi re-add "$file"
        echo "Synced $file to chezmoi"
    fi
}

# Watch and auto-sync common dotfiles
cwatch() {
    echo "Watching dotfiles for changes..."
    echo "Press Ctrl+C to stop"
    
    # List of common dotfiles to watch
    local files=(
        "$HOME/.zshrc"
        "$HOME/.bashrc" 
        "$HOME/.vimrc"
        "$HOME/.tmux.conf"
        "$HOME/.gitconfig"
    )
    
    # Use inotifywait if available
    if command -v inotifywait &> /dev/null; then
        for file in "${files[@]}"; do
            if [[ -f "$file" ]]; then
                inotifywait -m -e modify "$file" --format '%w' |
                while read changed_file; do
                    echo "Detected change in $changed_file"
                    csync "$changed_file"
                done &
            fi
        done
        wait
    else
        echo "Install inotify-tools for file watching: sudo pacman -S inotify-tools"
    fi
}

