# fzf session switcher widget (Ctrl-\ or Ctrl-_)
fzf-tmux-session-widget() {
  local sessions selected
  sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  if [[ -z "$sessions" ]]; then
    BUFFER='tmux new-session'
    zle accept-line
    return
  fi
  zle -I
  selected=$(printf '%s\n' "$sessions" | fzf \
    --height=40% --layout=reverse --border --prompt='Tmux: ' \
    --preview='tmux capture-pane -t {} 2>/dev/null | tail -20')
  [[ -z "$selected" ]] && { zle reset-prompt; return; }
  if [[ -n "$TMUX" ]]; then
    BUFFER="tmux switch-client -t ${(q)selected}"
  else
    BUFFER="tmux attach-session -t ${(q)selected}"
  fi
  zle accept-line
}
zle -N fzf-tmux-session-widget
bindkey '^\' fzf-tmux-session-widget
bindkey '^_' fzf-tmux-session-widget

# attach to a session picked with fzf
ta() {
  local session selected
  session=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  if [[ -z "$session" ]]; then
    echo "No tmux sessions available."
    return 1
  fi
  selected=$(printf '%s\n' "$session" | fzf --prompt='Tmux: ' --height=40% --layout=reverse --border)
  [[ -z "$selected" ]] && return
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$selected"
  else
    tmux attach-session -t "$selected"
  fi
}

# new session with optional name
tn() {
  if [ $# -eq 0 ]; then tmux new-session; else tmux new-session -s "$1"; fi
}

# kill session with optional name
tk() {
  if [ $# -eq 0 ]; then tmux kill-session; else tmux kill-session -t "$1"; fi
}

# new session named after current directory
tcd() {
  local session_name=$(basename "$PWD")
  tmux new-session -d -s "$session_name" -c "$PWD"
  tmux attach-session -t "$session_name"
}

# tmuxifier
alias tx='tmuxifier'
txs() {
  local session
  session=$(tmuxifier list-sessions | fzf --prompt='Tmuxifier: ' --height=40% --layout=reverse --border)
  [[ -n "$session" ]] && tmuxifier s "$session"
}
alias txn='tmuxifier new'
alias txl='tmuxifier list'
alias txe='tmuxifier edit'
alias txd='tmuxifier delete'
alias txc='tmuxifier copy'
alias txw='tmuxifier load-window'

