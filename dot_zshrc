# ----------------------------------------------------------------------------
# 12. DOTFILES MANAGEMENT (chezmoi)
# ----------------------------------------------------------------------------
alias ca="chezmoi add"
alias ce="chezmoi edit"
alias cu="chezmoi update"
alias capply="chezmoi apply"
alias cdiff="chezmoi diff"

# edit and apply in one command
cea() { chezmoi edit --apply "$1"; }

# edit with auto-apply on save
cew() { chezmoi edit --watch "$1"; }

# edit the chezmoi source file directly and apply
ces() {
  local file="$1"
  local source_file=$(chezmoi source-path "$file")
  if [[ -n "$source_file" ]]; then
    nvim "$source_file" && chezmoi apply "$file"
  else
    echo "File not managed by chezmoi: $file"
  fi
}

# sync an edited file into chezmoi (adds it first if unmanaged)
csync() {
  local file="$1"
  if [[ -z "$file" ]]; then
    echo "Usage: csync <file>"
    return 1
  fi
  if ! chezmoi managed "$file" &>/dev/null; then
    chezmoi add "$file"
    echo "Added $file to chezmoi"
  else
    chezmoi re-add "$file"
    echo "Synced $file to chezmoi"
  fi
}

# watch common dotfiles and auto-sync on change
cwatch() {
  echo "Watching dotfiles for changes... Press Ctrl+C to stop"
  local files=(
    "$HOME/.zshrc"
    "$HOME/.config/tmux/tmux.conf"
    "$HOME/.gitconfig"
  )
  if command -v inotifywait &> /dev/null; then
    for file in "${files[@]}"; do
      [[ -f "$file" ]] && inotifywait -m -e modify "$file" --format '%w' |
        while read changed_file; do
          echo "Detected change in $changed_file"
          csync "$changed_file"
        done &
    done
    wait
  else
    echo "Install inotify-tools for file watching: sudo pacman -S inotify-tools"
  fi
}

