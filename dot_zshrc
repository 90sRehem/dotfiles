# ============================================================================
# ZSH CONFIGURATION - organized by concern, single file
# Sections: guard > completions > omarchy > env/path > history/options >
#           plugins > tool hooks > dev environments > ssh agent >
#           aliases (fs/tmux/git/docker/dev/chezmoi/pkg) > functions >
#           help > local
# Machine-specific values live in ~/.zshrc.local (never tracked).
# ============================================================================

# ----------------------------------------------------------------------------
# 0. GUARD - nothing below runs for non-interactive shells
# ----------------------------------------------------------------------------
[[ $- != *i* ]] && return

# ----------------------------------------------------------------------------
# 1. COMPLETIONS
# ----------------------------------------------------------------------------
fpath=("$HOME/.zsh/completions" "$HOME/.docker/completions" $fpath)
autoload -Uz compinit && compinit

# ----------------------------------------------------------------------------
# 2. OMARCHY SHELL INTEGRATION
# ----------------------------------------------------------------------------
[[ -f /usr/share/omarchy-zsh/shell/zoptions ]] && source /usr/share/omarchy-zsh/shell/zoptions
[[ -f /usr/share/omarchy-zsh/shell/all ]] && source /usr/share/omarchy-zsh/shell/all

# ----------------------------------------------------------------------------
# 3. ENVIRONMENT & PATH
# ----------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"

# Android SDK and development environment
export JAVA_HOME=/opt/android-studio/jbr
export ANDROID_HOME=$HOME/Android/Sdk
export ANDROID_AVD_HOME="$HOME/.config/.android/avd"
export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in *":$PNPM_HOME:"*) ;; *) export PATH="$PNPM_HOME:$PATH" ;; esac

# LM Studio CLI
export PATH="$PATH:$HOME/.lmstudio/bin"

# opencode CLI
export PATH="$HOME/.opencode/bin:$PATH"

# Cargo bin (workmux and other tools)
export PATH="$HOME/.cargo/bin:$PATH"

# tmuxifier
export PATH="$HOME/.config/tmux/plugins/tmuxifier/bin:$PATH"

# opentmux wrapper: `opencode` runs inside tmux; use `oc` for the raw binary.
# The spawn wrapper is also available via `spawn` in PATH.
export OPENCODE_PORT=4096
alias opencode='opencode-tmux'

# ----------------------------------------------------------------------------
# 4. HISTORY & OPTIONS
# ----------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY   # share history across sessions
setopt autocd          # cd by typing the directory name
bindkey -v             # vi key bindings

# ----------------------------------------------------------------------------
# 5. PLUGIN MANAGER (zinit)
# ----------------------------------------------------------------------------
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
  print -P "%F{33} %F{220}Installing %F{33}zdharma-continuum/zinit%f{220}…%f"
  command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
  command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" &&
    print -P "%F{33} %F{34}Installation successful.%f%b" ||
    print -P "%F{160} The clone has failed.%f%b"
fi
source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

zinit load zdharma-continuum/history-search-multi-word
zstyle ':completion:*' menu no
zinit light Aloxaf/fzf-tab
zinit light zsh-users/zsh-autosuggestions
zinit light zdharma-continuum/fast-syntax-highlighting   # keep last: wraps zle
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-history-substring-search
zinit light MichaelAquilina/zsh-you-should-use           # reminds you of existing aliases
zinit light djui/alias-tips                              # suggests aliases as you type
zinit light hlissner/zsh-autopair                        # auto-close brackets/quotes

# fzf-tab previews
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza -1 --color=always $realpath'

# fzf default options
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"

# ----------------------------------------------------------------------------
# 6. TOOL HOOKS (eval-based CLIs)
# ----------------------------------------------------------------------------

# Mise (runtime version manager)
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
  export PATH="$HOME/.local/share/mise/shims:$PATH"
fi

# Zoxide (smart directory navigation)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# Oh My Posh prompt with Omarchy-synced theme + live reload on theme change
eval "$(oh-my-posh init zsh --config ~/.config/omp/themes/omarchy-current.omp.json)"
typeset -g OMARCHY_THEME_FILE="$HOME/.config/omarchy/current/theme.name"
typeset -g OMARCHY_THEME_LAST=""
_omarchy_reload_prompt_if_theme_changed() {
  [[ -f "$OMARCHY_THEME_FILE" ]] || return
  local current_theme
  current_theme=$(<"$OMARCHY_THEME_FILE")
  current_theme=${current_theme//[[:space:]]/}
  [[ -n "$current_theme" ]] || return
  [[ "$current_theme" == "$OMARCHY_THEME_LAST" ]] && return
  if [[ -x "$HOME/.local/bin/omarchy-zsh-hook" ]]; then
    "$HOME/.local/bin/omarchy-zsh-hook" "$current_theme" >/dev/null 2>&1 || true
  fi
  eval "$(oh-my-posh init zsh --config ~/.config/omp/themes/omarchy-current.omp.json)"
  OMARCHY_THEME_LAST="$current_theme"
}
autoload -Uz add-zsh-hook
add-zsh-hook -d precmd _omarchy_reload_prompt_if_theme_changed 2>/dev/null || true
add-zsh-hook precmd _omarchy_reload_prompt_if_theme_changed
_omarchy_reload_prompt_if_theme_changed

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# ----------------------------------------------------------------------------
# 7. SSH AGENT
# ----------------------------------------------------------------------------
if [ -z "$SSH_AUTH_SOCK" ]; then
  RUNNING_AGENT="$(ps -ax | grep 'ssh-agent -s' | grep -v grep | wc -l | tr -d '[:space:]')"
  if [ "$RUNNING_AGENT" = "0" ]; then
    ssh-agent -s &> "$HOME/.ssh/ssh-agent"
  fi
  eval "$(cat "$HOME/.ssh/ssh-agent")" > /dev/null
fi
ssh-add -l &>/dev/null || ssh-add ~/.ssh/id_rsa 2>/dev/null

