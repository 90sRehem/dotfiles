# Tmux Helper Functions
# Create new tmux session with optional name
tn() {
  if [ $# -eq 0 ]; then
    tmux new-session
  else
    tmux new-session -s "$1"
  fi
}

# Kill tmux session with optional name
tk() {
  if [ $# -eq 0 ]; then
    tmux kill-session
  else
    tmux kill-session -t "$1"
  fi
}

# Create tmux session named after current directory
tcd() {
  local session_name=$(basename "$PWD")
  tmux new-session -d -s "$session_name" -c "$PWD"
  tmux attach-session -t "$session_name"
}

