# openchamber background starter used by alias c
_c_start() {
  ss -tlnp 2>/dev/null | grep -q ":3000 " && return 0
  OPENCODE_PORT="${OPENCODE_PORT:-4096}" \
  OPENCODE_SKIP_START=true \
  OPENCHAMBER_HOST="0.0.0.0" \
  nohup openchamber --port 3000 --ui-password teste >/dev/null 2>&1 &
  sleep 2
}

# yazi shell wrapper (cd on exit)
y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# improved cd: plain cd for dirs, zoxide otherwise
alias cd="zd"
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf " \U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}

# fuzzy find and open in nvim
fv() {
  local file
  file=$(fzf --preview 'bat --style=numbers --color=always {}') && [ -n "$file" ] && nvim "$file"
}

