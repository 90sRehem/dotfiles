#!/bin/bash
# Watcher contínuo para mudanças de tema do Omarchy

echo "Iniciando monitoramento de tema do Omarchy para Kitty..."

# Aplicar tema inicial
~/.local/bin/kitty-theme-sync

# Função para monitorar mudanças no symlink
monitor_theme_changes() {
    local current_theme=""
    
    while true; do
        local new_theme=$(omarchy-theme-current 2>/dev/null || echo "")
        
        if [[ "$new_theme" != "$current_theme" && -n "$new_theme" ]]; then
            echo "Mudança de tema detectada: $current_theme -> $new_theme"
            current_theme="$new_theme"
            sleep 0.5  # Pequeno delay para estabilizar
            ~/.local/bin/kitty-theme-sync
        fi
        
        sleep 2  # Verificar a cada 2 segundos
    done
}

# Iniciar monitoramento
monitor_theme_changes