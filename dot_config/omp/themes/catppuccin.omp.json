{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#8AADF4",
    "lavender": "#B7BDF8",
    "os": "#ACB0BE",
    "pink": "#F5BDE6",
    "text": "#494D64",
    "wight": "#FFFFFF",
    "green": "#A6E3A1",
    "yellow": "#F9E2AF",
    "orange": "#FAB387",
    "red": "#F38BA8",
    "purple": "#CBA6F7",
    "teal": "#94E2D5"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b6",
          "template": "{{.Icon}} ",
          "foreground": "p:wight",
          "powerline_symbol": "\ue0b4",
          "background": "p:blue",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ .UserName }}",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b4",
          "background": "p:blue",
          "type": "session",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "template": " \uf07c {{ .Path }}",
          "foreground": "p:wight",
          "powerline_symbol": "\ue0b4",
          "background": "p:lavender",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ .HEAD }}",
          "foreground": "p:wight",
          "powerline_symbol": "\ue0b4",
          "background": "p:teal",
          "type": "git",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "enabled": false
          },
          "template": " \uf2e7 {{ .Full }}",
          "foreground": "p:wight",
          "powerline_symbol": "\ue0b4",
          "background": "p:green",
          "type": "node",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "enabled": false
          },
          "template": " \ue235 {{ .Full }}",
          "foreground": "p:wight",
          "powerline_symbol": "\ue0b4",
          "background": "p:yellow",
          "type": "python",
          "style": "powerline"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "error_threshold": 0,
            "success_threshold": 0
          },
          "template": "\ue0b4",
          "foreground": "p:red",
          "background": "p:orange",
          "type": "exit",
          "style": "diamond"
        }
      ],
      "newline": true
    }
  ],
  "final_space": true,
  "version": 2
}
