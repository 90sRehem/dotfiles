# Fuzzy find and open in nvim
fv() {
  local file
  file=$(fzf --preview 'bat --style=numbers --color=always {}') && [ -n "$file" ] && nvim "$file"
}

# Navegação de diretórios
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# cd com zoxide: tenta cd normal, senão usa zoxide
alias cd="zd"
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf " \U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}

