alias ca="chezmoi add"
alias ce="chezmoi edit"
alias cu="chezmoi update"
alias capply="chezmoi apply"
alias cdiff="chezmoi diff"

# Editar e aplicar em um comando
cea() {
  chezmoi edit --apply "$1"
}

# Editar com watch (auto-apply ao salvar)
cew() {
  chezmoi edit --watch "$1"
}

# Editar source file diretamente e aplicar
ces() {
  local file="$1"
  local source_file=$(chezmoi source-path "$file")
  if [[ -n "$source_file" ]]; then
    nvim "$source_file" && chezmoi apply "$file"
  else
    echo "File not managed by chezmoi: $file"
  fi
}

# Sincronizar arquivo editado para o chezmoi
csync() {
  local file="$1"
  if [[ -z "$file" ]]; then
    echo "Usage: csync <file>"
    return 1
  fi
  if ! chezmoi managed "$file" &>/dev/null; then
    chezmoi add "$file"
    echo "Added $file to chezmoi"
  else
    chezmoi re-add "$file"
    echo "Synced $file to chezmoi"
  fi
}

# Watch e auto-sync de dotfiles comuns
cwatch() {
  echo "Watching dotfiles for changes..."
  echo "Press Ctrl+C to stop"

  local files=(
    "$HOME/.zshrc"
{{- if ne .chezmoi.os "darwin" }}
    "$HOME/.bashrc"
{{- end }}
    "$HOME/.vimrc"
    "$HOME/.tmux.conf"
    "$HOME/.gitconfig"
  )

{{- if eq .chezmoi.os "darwin" }}
  if command -v fswatch &> /dev/null; then
    for file in "${files[@]}"; do
      if [[ -f "$file" ]]; then
        fswatch -o "$file" | while read _; do
          echo "Detected change in $file"
          csync "$file"
        done &
      fi
    done
    wait
  else
    echo "Install fswatch for file watching: brew install fswatch"
  fi
{{- else }}
  # Use inotifywait if available
  if command -v inotifywait &> /dev/null; then
    for file in "${files[@]}"; do
      if [[ -f "$file" ]]; then
        inotifywait -m -e modify "$file" --format '%w' |
        while read changed_file; do
          echo "Detected change in $changed_file"
          csync "$changed_file"
        done &
      fi
    done
    wait
  else
    echo "Install inotify-tools for file watching: sudo pacman -S inotify-tools"
  fi
{{- end }}
}

